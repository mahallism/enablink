# ── Existing entries ──
backup/*
backup_wp/*
vendor/*
uploads/*

# ── Environment & secrets ──
.env
.env.*
!.env.example
.env.local
.env.production
.env.staging

# ── Laravel (target migrasi) ──
laravel/vendor/
laravel/node_modules/
laravel/.env
laravel/.env.*
laravel/storage/*.key
laravel/storage/logs/
laravel/storage/framework/cache/data/
laravel/storage/framework/sessions/
laravel/storage/framework/views/
laravel/bootstrap/cache/*.php
laravel/public/hot
laravel/public/storage
laravel/.phpunit.result.cache
laravel/.phpunit.cache
laravel/coverage/
laravel/Homestead.json
laravel/Homestead.yaml
laravel/auth.json
laravel/npm-debug.log
laravel/yarn-error.log

# ── CodeIgniter sensitive ──
# database.php aman (tanpa fallback password) — tetap di-track
contents/config/database.php

# ── Database dumps (jangan commit) ──
*.sql
!enablink_struktur_prod.sql
!enablink_struktur_dev.sql
!db_enablink_structur.sql

# ── Deploy & logs ──
logs/
*.log
deploy-*.log
scripts/*.log

# ── IDE & OS ──
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Mobile (Flutter, fase 5) ──
mobile/**/build/
mobile/**/.dart_tool/
mobile/**/.flutter-plugins
mobile/**/.flutter-plugins-dependencies
mobile/**/ios/Pods/
mobile/**/android/.gradle/
mobile/**/google-services.json
mobile/**/GoogleService-Info.plist

# ── Firebase & push keys ──
firebase-adminsdk*.json
*-firebase-adminsdk-*.json

# ── Composer (CI legacy) ──
composer.lock

# ── Uploads & user content ──
storage/app/public/*
!storage/app/public/.gitkeep
