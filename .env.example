# Salin ke .env dan isi nilai production/lokal.
# JANGAN commit file .env ke Git.

# development | testing | production
ENVIRONMENT=production

# Database
DB_DNS=
DB_HOSTNAME=localhost
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=
DB_DRIVER=mysqli

# App
APP_NAME=Enablink
APP_VERTION=1.0

# Email (SMTP)
MAIL_SMTP_HOST=ssl://smtp.gmail.com
MAIL_SMTP_PORT=465
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
MAIL_SENDER_EMAIL=
MAIL_SENDER_NAME=Enablink

# Firebase Cloud Messaging (server key)
FIREBASE_SERVER_KEY=
